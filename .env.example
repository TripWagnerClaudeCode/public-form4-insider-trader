# Copy to .env and fill in. Never commit .env.
# Alpaca PAPER keys (this bot never trades live)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Required by SEC fair-access rules: "Your Name your@email"
EDGAR_IDENTITY=
# Only needed with agents.backend: api
ANTHROPIC_API_KEY=
# Optional phone pushes via ntfy (ntfy.sh or self-hosted). Use a long random topic on ntfy.sh.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Set to yes to halt all trading
BOT_KILL_SWITCH=no
